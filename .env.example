DB_PASSWORD=change-me
JWT_SECRET=change-me-too
ADMIN_EMAIL=admin@thetiptop.fr
ADMIN_PASSWORD=Admin123!

# HTTPS (Caddy). En local : http://localhost
# En production, le domaine public (Let's Encrypt) :
SITE_ADDRESS=http://localhost
ACME_EMAIL=admin@thetiptop.fr
# Panels (DNS A vers le serveur, certificats Let's Encrypt via Caddy) :
# https://jenkins.dsp5-archi-024a-g3.fr/
# https://prometheus.dsp5-archi-024a-g3.fr/
# https://grafana.dsp5-archi-024a-g3.fr/
# https://kibana.dsp5-archi-024a-g3.fr/

# Connexion Google (Client ID public, le même côté API et frontend)
GOOGLE_CLIENT_ID=

# Budget marketing fictif de la campagne (ROI admin = valeur des lots / budget)
CAMPAGNE_BUDGET=15000

# E-mails (mot de passe oublié).
# En Docker, Mailpit intercepte les messages : http://localhost:8025
# Pour une vraie boîte, remplacez par un SMTP (Brevo, Gmail, etc.).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thé Tip Top <noreply@thetiptop.fr>
PUBLIC_APP_URL=http://localhost
