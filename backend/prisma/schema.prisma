generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  EMPLOYEE
  ADMIN
  CAISSE
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  role       Role     @default(CLIENT)
  firstName  String   @default("Cher")     // Valeur par défaut pour sauver la base
  lastName   String   @default("Client")   // Valeur par défaut pour sauver la base
  newsletter Boolean  @default(false)      // Ajout de l'opt-in newsletter
  createdAt  DateTime @default(now())
  gains      Gain[]
}

model Ticket {
  code       String   @id
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
  lotId      String?
  lot        Lot?     @relation(fields: [lotId], references: [id])
  gain       Gain?
}

model Lot {
  id       String   @id @default(uuid())
  name     String   @unique
  stock    Int
  gains    Gain[]
  tickets  Ticket[]
}

model Gain {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  ticket     Ticket   @relation(fields: [ticketCode], references: [code])
  ticketCode String   @unique
  lot        Lot      @relation(fields: [lotId], references: [id])
  lotId      String
  claimed    Boolean  @default(false)
  wonAt      DateTime @default(now())
}