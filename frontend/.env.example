# ============================================
# Thé Tip Top - Variables d'environnement
# Frontend (Vite)
# ============================================

# URL de l'API backend
# Développement local : http://localhost:3000/api
# Production : https://api.dsp5-archi-[classe]-[groupe].fr/api
VITE_API_URL=http://localhost:3000/api

# Nom de l'application (pour titres, métas, emails)
VITE_APP_NAME=Thé Tip Top

# Version de l'application (optionnel, pour debug)
VITE_APP_VERSION=1.0.0

# Environnement : development | production
VITE_NODE_ENV=development

# ============================================
# INSTRUCTIONS
# ============================================
# 1. Copier ce fichier : cp .env.example .env
# 2. Remplir les valeurs réelles dans .env
# 3. NE JAMAIS commit .env (déjà dans .gitignore)
# ============================================